{
  "name": "@deepseek-ai/dsh-nilm-scheduler",
  "description": "NILM scheduled morning reports, monthly power-factor projections, and R-08 data-quality inspection with idempotent job runs",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-nilm-analytics": "workspace:*",
    "@deepseek-ai/dsh-nilm-assets": "workspace:*",
    "@deepseek-ai/dsh-nilm-context": "workspace:*",
    "@deepseek-ai/dsh-nilm-core": "workspace:*",
    "@deepseek-ai/dsh-nilm-sentinel": "workspace:*",
    "@deepseek-ai/dsh-nilm-source": "workspace:*",
    "@deepseek-ai/dsh-nilm-tariff": "workspace:*",
    "@deepseek-ai/dsh-nilm-timeseries": "workspace:*",
    "@deepseek-ai/schemastery": "link:../../../vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "scripts": {
    "test:morning-report": "vitest run tests/morning-report.spec.ts -t 'twenty tenants'"
  }
}
