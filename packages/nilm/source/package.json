{
  "name": "@deepseek-ai/dsh-nilm-source",
  "description": "Read-only NILM source adapters for upstream MySQL, TDengine hot/statistics clusters, and the cold proxy",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./sql/*": "./sql/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:connectivity": "node --import tsx/esm scripts/connectivity.ts"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "sql",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-nilm-core": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "mysql2": "^3.11.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
