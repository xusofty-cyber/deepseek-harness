{
  "name": "@deepseek-ai/dsh-nilm-tools",
  "description": "NILM model-facing scope, energy, and safety tools with bounded structured results",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
