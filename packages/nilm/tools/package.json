    "@deepseek-ai/dsh-nilm-core": "workspace:*",
    "@deepseek-ai/dsh-nilm-safety": "workspace:*",
    "@deepseek-ai/dsh-nilm-tariff": "workspace:*",
    "@deepseek-ai/dsh-nilm-timeseries": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "link:../../../vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
