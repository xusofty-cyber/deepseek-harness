{
  "name": "@deepseek-ai/dsh-nilm-analytics",
  "description": "Pure NILM energy-cost, power-quality, CUSUM, running-time, and period-comparison calculations",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-nilm-core": "workspace:*",
    "@deepseek-ai/dsh-nilm-tariff": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "scripts": {
    "test:cusum": "vitest run tests/cusum.spec.ts"
  }
}
